msgid "Manage images"
msgstr "Gestisci immagini"

#: src/transume/ui/pages.py:370
msgid "Discover, inspect, verify, rename, delete, and explore supported Partclone images read-only."
msgstr "Scopri, ispeziona, verifica, rinomina, elimina ed esplora in sola lettura le immagini Partclone supportate."

#: src/transume/ui/pages.py:371
msgid "Use different storage"
msgstr "Usa un altro supporto di archiviazione"

#: src/transume/ui/pages.py:371
msgid "Work with local, removable, SMB, NFS, and SSH storage locations."
msgstr "Lavora con percorsi di archiviazione locali, rimovibili, SMB, NFS e SSH."

#: src/transume/ui/pages.py:377
msgid "Safety by design"
msgstr "Sicurezza integrata"

#: src/transume/ui/pages.py:379
msgid "Least privilege"
msgstr "Minimi privilegi"

#: src/transume/ui/pages.py:379
msgid "The interface runs without root and requests PolicyKit authorization only for privileged work."
msgstr "L'interfaccia funziona senza root e richiede l'autorizzazione PolicyKit solo per le operazioni privilegiate."

#: src/transume/ui/pages.py:380
msgid "Device protection"
msgstr "Protezione dispositivi"

#: src/transume/ui/pages.py:380
msgid "Stable identities, mount state, relationships, target size, and repository capacity are rechecked before execution."
msgstr "Identità stabili, stato di mount, relazioni, dimensione di destinazione e capacità del repository vengono ricontrollati prima dell'esecuzione."

#: src/transume/ui/pages.py:381
msgid "Private data"
msgstr "Dati privati"

#: src/transume/ui/pages.py:381
msgid "Credentials and passphrases are never stored in plans, command previews, activity history, or logs."
