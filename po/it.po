msgstr "Esegui backup di dischi completi o partizioni selezionate, con verifica e cifratura nativa opzionale."

#: src/transume/ui/pages.py:368
msgid "Restore images"
msgstr "Ripristina immagini"

#: src/transume/ui/pages.py:368
msgid "Restore supported full-disk and partition images with explicit destination warnings."
msgstr "Ripristina immagini supportate di dischi interi e partizioni con avvisi espliciti sulla destinazione."

