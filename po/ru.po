#: src/transume/ui/pages.py:367
msgid "Create images"
msgstr "Создание образов"

#: src/transume/ui/pages.py:367
msgid "Back up complete disks or selected partitions, with verification and optional native encryption."
msgstr "Резервное копирование целых дисков или выбранных разделов с проверкой и опциональным шифрованием."

#: src/transume/ui/pages.py:368
msgid "Restore images"
msgstr "Восстановление образов"

#: src/transume/ui/pages.py:368
msgid "Restore supported full-disk and partition images with explicit destination warnings."
msgstr "Восстановление поддерживаемых образов дисков и разделов с явными предупреждениями о назначении."

#: src/transume/ui/pages.py:369
msgid "Clone storage"
msgstr "Клонирование хранилища"

#: src/transume/ui/pages.py:369
msgid "Copy a disk or partition directly to an equal or larger local destination."
msgstr "Копируйте диск или раздел напрямую на локальный диск равного или большего размера."

#: src/transume/ui/pages.py:370
msgid "Manage images"
msgstr "Управление образами"

#: src/transume/ui/pages.py:370
msgid "Discover, inspect, verify, rename, delete, and explore supported Partclone images read-only."
msgstr "Обнаруживайте, просматривайте, проверяйте, переименовывайте, удаляйте и исследуйте поддерживаемые образы Partclone только для чтения."

#: src/transume/ui/pages.py:371
msgid "Use different storage"
msgstr "Использовать другое хранилище"

#: src/transume/ui/pages.py:371
msgid "Work with local, removable, SMB, NFS, and SSH storage locations."
msgstr "Работайте с локальными, съемными, SMB, NFS и SSH хранилищами."

#: src/transume/ui/pages.py:377
msgid "Safety by design"
msgstr "Безопасность по умолчанию"

#: src/transume/ui/pages.py:379
msgid "Least privilege"
msgstr "Минимальные привилегии"

#: src/transume/ui/pages.py:379
msgid "The interface runs without root and requests PolicyKit authorization only for privileged work."
msgstr "Интерфейс работает без root и запрашивает авторизацию PolicyKit только для операций, требующих повышенных прав."

#: src/transume/ui/pages.py:380
msgid "Device protection"
msgstr "Защита устройств"

#: src/transume/ui/pages.py:380
msgid "Stable identities, mount state, relationships, target size, and repository capacity are rechecked before execution."
msgstr "Перед выполнением повторно проверяются идентификаторы устройств, состояние монтирования, связи, целевой размер и емкость репозитория."

#: src/transume/ui/pages.py:381
