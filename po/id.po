msgid "Clone storage"
msgstr "Klon penyimpanan"

#: src/transume/ui/pages.py:369
msgid "Copy a disk or partition directly to an equal or larger local destination."
msgstr "Salin disk atau partisi secara langsung ke tujuan lokal yang sama atau lebih besar."

#: src/transume/ui/pages.py:370
msgid "Manage images"
msgstr "Kelola image"

#: src/transume/ui/pages.py:370
msgid "Discover, inspect, verify, rename, delete, and explore supported Partclone images read-only."
msgstr "Temukan, inspeksi, verifikasi, ganti nama, hapus, dan jelajahi image Partclone yang didukung secara read-only."

#: src/transume/ui/pages.py:371
msgid "Use different storage"
msgstr "Gunakan penyimpanan lain"

#: src/transume/ui/pages.py:371
msgid "Work with local, removable, SMB, NFS, and SSH storage locations."
msgstr "Bekerja dengan lokasi penyimpanan lokal, removable, SMB, NFS, dan SSH."

#: src/transume/ui/pages.py:377
msgid "Safety by design"
msgstr "Keamanan sejak desain"

#: src/transume/ui/pages.py:379
msgid "Least privilege"
msgstr "Hak akses minimum"

#: src/transume/ui/pages.py:379
msgid "The interface runs without root and requests PolicyKit authorization only for privileged work."
msgstr "Antarmuka berjalan tanpa root dan hanya meminta otorisasi PolicyKit untuk pekerjaan yang membutuhkan hak istimewa."

#: src/transume/ui/pages.py:380
msgid "Device protection"
msgstr "Perlindungan perangkat"

#: src/transume/ui/pages.py:380
msgid "Stable identities, mount state, relationships, target size, and repository capacity are rechecked before execution."
msgstr "Identitas stabil, status mount, relasi, ukuran target, dan kapasitas repositori akan dicek ulang sebelum eksekusi."

#: src/transume/ui/pages.py:381
msgid "Private data"
msgstr "Data pribadi"

#: src/transume/ui/pages.py:381
msgid "Credentials and passphrases are never stored in plans, command previews, activity history, or logs."
