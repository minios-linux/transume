#: src/transume/ui/pages.py:367
msgid "Back up complete disks or selected partitions, with verification and optional native encryption."
msgstr "Backup seluruh disk atau partisi terpilih, dengan verifikasi dan enkripsi native opsional."

#: src/transume/ui/pages.py:368
msgid "Restore images"
msgstr "Pulihkan image"

#: src/transume/ui/pages.py:368
msgid "Restore supported full-disk and partition images with explicit destination warnings."
msgstr "Pulihkan image full-disk dan partisi yang didukung dengan peringatan tujuan yang jelas."

